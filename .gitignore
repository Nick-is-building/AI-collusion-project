# secrets and local environment
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
# downloaded upstream data (reproduced by data/download.py and checksums)
data/raw/
# local logs and reconstructable full request payloads
logs/
results/requests/
# blind check answer key (only its hash is committed)
blind_check/key.local.json
# local working copies (unpacked proof package, reruns); reconstructable
work/
# local scratch files (inside the repository, never committed)
scratch/

# Study 2: uncompressed run records stay local; the gzipped copies (run.json.gz) are committed (A05)
results/study2/**/run.json
results/study2/**/run.json.tmp
results/study2/STOP
# Study 2 main run (D27): full traces stay local (HF dataset later); committed: manifest.csv,
# files_sha256.txt, calls.csv.gz, scheduler.jsonl, runs.csv, study2_meta.json
results/study2/main/**/llm_usage.jsonl
results/study2/main/**/bob_cache/
results/study2/main/**/run.json.gz
# A05b: superseded main-run C′ attempts (moved, same D27 storage rule)
results/study2/main_superseded/**/llm_usage.jsonl
results/study2/main_superseded/**/bob_cache/
results/study2/main_superseded/**/run.json.gz
